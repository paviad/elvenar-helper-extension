{
  "name": "elven-assist",
  "version": "7.6.0",
  "description": "Unofficial extension to help with Elvenar city planning",
  "license": "GNU GPLv3",
  "author": "Aviad Pineles",
  "sideEffects": false,
  "main": "index.js",
  "scripts": {
    "prebuild": "node util/check-branch.js",
    "prepack": "npm run prebuild",
    "prepack:firefox": "npm run prebuild",
    "prepack:safari": "npm run prebuild",
    "test": "jest",
    "webpack": "npm run webpack:chrome",
    "webpack:chrome": "copy /y manifest\\manifest-chrome.json assets\\manifest.json && webpack",
    "webpack:firefox": "copy /y manifest\\manifest-firefox.json assets\\manifest.json && webpack --env=firefox",
    "start": "ts-node index.ts",
    "pack": "npm run pack:chrome",
    "pack:chrome": "copy /y manifest\\manifest-chrome.json assets\\manifest.json && webpack --env=production && node util/create-store-package.js",
    "pack:safari": "cp manifest/manifest-safari.json assets/manifest.json && webpack --env=production && node util/create-store-package.js",
    "pack:firefox": "copy /y manifest\\manifest-firefox.json assets\\manifest.json && webpack --env=firefox --env=production && node util/create-store-package.js firefox",
    "lint": "eslint src",
    "prettify": "prettier --write src",
    "bump": "node util/set-version.js",
    "release": "node util/create-release.js",
    "deploy:chrome": "node util/deploy-chrome.js",
    "deploy:firefox": "node util/deploy-firefox.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "adm-zip": "^0.5.17",
    "chrome-types": "^0.1.426",
    "chrome-webstore-upload-cli": "^3.5.0",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^10.3.0",
    "jest": "^30.4.0",
    "jszip": "^3.10.1",
    "prettier": "^3.8.3",
    "simple-git": "^3.36.0",
    "ts-jest": "^29.4.9",
    "ts-loader": "^9.5.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2",
    "web-ext": "^10.1.0",
    "webpack": "^5.106.2",
    "webpack-cli": "^7.0.2",
    "webpack-manifest-plugin": "^6.0.1"
  },
  "nx": {},
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "date-fns": "^4.1.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "^7.15.0",
    "rxjs": "^7.8.2",
    "zustand": "^5.0.13"
  }
}
