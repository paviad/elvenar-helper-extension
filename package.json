{
  "name": "elven-assist",
  "version": "8.3.1",
  "description": "Unofficial extension to help with Elvenar city planning",
  "license": "GNU GPLv3",
  "author": "Aviad Pineles",
  "sideEffects": false,
  "main": "index.js",
  "scripts": {
    "prebuild": "node util/check-branch.js",
    "prepack": "npm run prebuild",
    "prepack:firefox": "npm run prebuild",
    "prepack:safari": "npm run prebuild",
    "test": "jest",
    "buildmanifest:chrome": "node util/build-manifest.js chrome",
    "buildmanifest:chrome:prod": "node util/build-manifest.js chrome --prod",
    "buildmanifest:firefox": "node util/build-manifest.js firefox",
    "buildmanifest:firefox:prod": "node util/build-manifest.js firefox --prod",
    "buildmanifest:safari": "node util/build-manifest.js safari",
    "buildmanifest:safari:prod": "node util/build-manifest.js safari --prod",
    "webpack": "npm run webpack:chrome",
    "webpack:chrome": "npm run buildmanifest:chrome && webpack",
    "webpack:firefox": "npm run buildmanifest:firefox && webpack --env=firefox",
    "start": "ts-node index.ts",
    "pack": "npm run pack:chrome",
    "pack:chrome": "npm run buildmanifest:chrome:prod && webpack --env=production && node util/create-store-package.js",
    "pack:safari": "npm run buildmanifest:safari:prod && webpack --env=production && node util/create-store-package.js",
    "pack:firefox": "npm run buildmanifest:firefox:prod && webpack --env=firefox --env=production && node util/create-store-package.js firefox",
    "lint": "eslint src",
    "prettify": "prettier --write src",
    "bump": "node util/set-version.js",
    "release": "npm run check-logs && node util/create-release.js",
    "deploy:chrome": "npm run check-logs && node util/deploy-chrome.js",
    "deploy:firefox": "npm run check-logs && node util/deploy-firefox.js",
    "check-logs": "node util/check-logs.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "adm-zip": "^0.5.17",
    "chrome-types": "^0.1.429",
    "chrome-webstore-upload-cli": "^4.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^10.4.0",
    "eslint-plugin-jest": "^29.15.2",
    "jest": "^30.4.2",
    "jszip": "^3.10.1",
    "prettier": "^3.8.3",
    "simple-git": "^3.36.0",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.5.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "web-ext": "^10.2.0",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.2",
    "webpack-manifest-plugin": "^6.0.1"
  },
  "nx": {},
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "date-fns": "^4.3.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "^7.15.1",
    "rxjs": "^7.8.2",
    "zustand": "^5.0.13"
  },
  "overrides": {
    "tmp": "^0.2.6"
  }
}
