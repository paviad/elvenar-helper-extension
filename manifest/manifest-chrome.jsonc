{
  "manifest_version": 3,
  "name": "ElvenAssist",
  "version": "10.2.1",
  "description": "A comprehensive unofficial toolkit for Elvenar featuring a live city planner, inventory manager, and FA tracker.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "webRequest"
  ],
  "host_permissions": [
    "https://*.elvenar.com/*",
    "https://*.innogamescdn.com/*",
    "https://javascriptorian.com/*"
  ],
  "background": {
    "service_worker": "elvenassist-service-worker.bundle.js"
  },
  "action": {
    "default_title": "(Click to show tab)"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icon32.png",
        "sprite.png",
        "military_sprite.png",
        "elvenassist-inject.bundle.js",
        "elvenassist-vendors.bundle.js",
        "helper.png",
        "splitview.jpg",
        "*.js.map" // debug
      ],
      "matches": [
        "https://*.elvenar.com/*"
      ]
    },
    {
      "resources": [
        "elvenassist-spirewizard-inject.bundle.js"
      ],
      "matches": [
        "https://javascriptorian.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.elvenar.com/*"
      ],
      "js": [
        "elvenassist-vendors.bundle.js",
        "elvenassist-overlay.bundle.js",
        "elvenassist-shared-overlay-tab.bundle.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.elvenar.com/*"
      ],
      "js": [
        "elvenassist-overlay-inject.bundle.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://javascriptorian.com/*"
      ],
      "js": [
        "elvenassist-spirewizard.bundle.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}