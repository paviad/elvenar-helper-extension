{
  "manifest_version": 3,
  "name": "ElvenAssist",
  "version": "8.4.2",
  "description": "A comprehensive unofficial toolkit for Elvenar featuring a live city planner, inventory manager, and FA tracker.",
  "permissions": [
    "storage",
    "webRequest"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "@elvenar-helper-extension",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ],
        "optional": []
      }
    }
  },
  "host_permissions": [
    "https://*.elvenar.com/*",
    "https://*.innogamescdn.com/*",
    "https://javascriptorian.com/*"
  ],
  "background": {
    "scripts": [
      "elvenassist-service-worker.bundle.js"
    ]
  },
  "action": {
    "default_title": "(Click to show tab)"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icon32.png",
        "sprite.png",
        "elvenassist-inject.bundle.js",
        "elvenassist-vendors.bundle.js",
        "helper.png",
        "splitview.jpg",
        "*.js.map" // debug
      ],
      "matches": [
        "https://*.elvenar.com/*"
      ]
    },
    {
      "resources": [
        "elvenassist-spirewizard-inject.bundle.js"
      ],
      "matches": [
        "https://javascriptorian.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.elvenar.com/*"
      ],
      "js": [
        "elvenassist-vendors.bundle.js",
        "elvenassist-overlay.bundle.js",
        "331.bundle.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.elvenar.com/*"
      ],
      "js": [
        "elvenassist-vendors.bundle.js",
        "elvenassist-overlay-inject.bundle.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://javascriptorian.com/*"
      ],
      "js": [
        "elvenassist-vendors.bundle.js",
        "elvenassist-spirewizard.bundle.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
