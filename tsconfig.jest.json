{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "target": "ES2020",
    "types": ["jest", "node"],
    "esModuleInterop": true,
    "allowJs": true,
    "outDir": "./build-jest",
    "sourceMap": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": [
    "src/**/*.spec.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "build-jest"
  ]
}
